# ============================================
# 1. Kredensial & Konfigurasi Sensitif
# ============================================
.env
.env.local
.env.working
# Backup .env & archive jangan masuk repo / webroot (bocor kredensial & data privat)
*.env.bak*
*.env.bak-*
default.tar.gz
*.tar.gz
# .env.production sengaja TIDAK diabaikan (berisi template, bukan kredensial)
config/config.php

# ============================================
# 2. Uploads (User-generated content)
#    Folder struktur tetap di-track, isi tidak
# ============================================
uploads/*
!uploads/.gitkeep
!uploads/ttd/
uploads/ttd/*
!uploads/ttd/.gitkeep
!uploads/umum/
uploads/umum/*
!uploads/umum/.gitkeep

# ============================================
# 3. Scratch — Development & Debug Scripts
#    KECUALI bem_lpj_manager.py (dipakai produksi)
# ============================================
scratch/*
!scratch/bem_lpj_manager.py

# ============================================
# 4. Utility Scripts (Berbahaya di produksi)
# ============================================
migrate-direct.php
init-admin.php
test-db.php
dump_pengaturan.php
astawidya/env-test.php
config/database-backup.php
admin/auth/dev-login.php
admin/system/test-url.php
admin/system/test_foreach.php
admin/system/setup-s3-*.php

# ============================================
# 5. Docker & Server Config
# Dockerfile lama (sudah diganti Dockerfile.prod)
# ============================================
nginx.conf.example
# Backup dumps database
databases/dump_migration_*.sql.gz
databases/dump_*.sql.gz
# Folder certbot (generated di VPS)
certbot_www/
certbot_conf/
# Backups
backups/

# ============================================
# 6. Dependencies & Build Artifacts
# ============================================
node_modules/
admin/node_modules/
admin/node_modules.zip
admin/package-lock.json
admin/package.json
vendor/

# ============================================
# 7. Logs & Cache
# ============================================
logs/*
!logs/.gitkeep
*.log
.cache/

# ============================================
# 8. OS & IDE Files
# ============================================
.DS_Store
Thumbbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# 9. Python Artifacts
# ============================================
__pycache__/
*.pyc
*.pyo

# ============================================
# 10. Documentation & Identitas
# ============================================
identitas/

config/firebase-service-account.json

# ============================================
# 11. Mobile APK artifacts (generated by GitHub Actions)
#     APK + metadata SELALU di-generate runtime, tidak di-track
# ============================================
downloads/*.apk
downloads/*.sha1
downloads/releases.json
downloads/sha256.txt
mobile_app/build/
