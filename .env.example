# ============================================
# BEM MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# Copy file ini menjadi .env lalu sesuaikan nilainya
# ============================================

# --- APPLICATION ---
# APP_ENV development = BASE_URL otomatis detect localhost; production = isi domain Anda.
APP_ENV=production
# Ganti dengan domain publik Anda. Di localhost, biarkan BASE_URL kosong agar
# sistem otomatis mendeteksi dari request (misal: http://localhost/bem/).
BASE_URL=https://your-domain-vps.com/

# --- DATABASE (MYSQL / MARIADB) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_USER=bem_user
DB_PASS=your_secure_db_password_here
DB_NAME=bem_astawidya
DB_ROOT_PASS=your_secure_db_root_password_here

# --- SECURITY ---
DEBUG_TOKEN=generate_random_secret_token_here

# --- CLOUDFLARE TURNSTILE (CAPTCHA) ---
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=your_production_turnstile_site_key
TURNSTILE_SECRET_KEY=your_production_turnstile_secret_key

# --- GOOGLE OAUTH 2.0 ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain-vps.com/admin/auth/google-callback.php

# --- STORAGE CONFIGURATION (S3 OBJECT STORAGE) ---
STORAGE_METHOD=s3
S3_ENDPOINT=https://s3.nevaobjects.id
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_BUCKET=bucket-bem
S3_PUBLIC_URL=https://bucket-bem.s3.nevaobjects.id
